# Copy to .env and adjust. Used by local uvicorn and verify-demo scripts.
API_TOKEN=change-me-to-a-long-random-secret
ORCHESTRATOR_DEMO_MODE=true

# Sub-agent base URLs (see runbook-local.md port map)
CONTAM_API_BASE=http://127.0.0.1:8001
DESEQ_API_BASE=http://127.0.0.1:8000
REPORT_API_BASE=http://127.0.0.1:8002

# Orchestrator listen port (documentation only; set when starting uvicorn)
# ORCHESTRATOR_PORT=8003

# Optional: persist run state outside the demo folder
# RUNS_DIR=./runs

# Shared cohort bundles for contamination + DESeq (default: demos/_shared_studies)
# STUDIES_DIR=../_shared_studies

# Optional: parent orchestrator webhook for submit_to_parent
# PARENT_ORCHESTRATOR_URL=http://127.0.0.1:9000/handoff
